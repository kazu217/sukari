{
  "expo": {
    "name": "スキャリ",
    "slug": "sukari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "jp.sukari.app",
      "appleTeamId": "QRKZX32XMT",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "バーコードをスキャンして商品価格を検索するために使用します。",
        "NSPhotoLibraryUsageDescription": "商品バーコードの画像を読み込むために使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "jp.sukari.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera"
    ],
    "extra": {
      "eas": {
        "projectId": "bf93de9b-7b8d-405e-bb5d-6226e5c9ee4b"
      }
    },
    "owner": "rikougakubu"
  }
}
